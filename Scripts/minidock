#!/usr/bin/env bash
set -e

APP_PATH="/Applications/MiniDock.app"
FALLBACK_APP_PATH="$HOME/Applications/MiniDock.app"
PLIST_PATH="$HOME/Library/LaunchAgents/com.user.minidock.plist"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." 2>/dev/null && pwd)"

if [ ! -d "$APP_PATH" ] && [ -d "$FALLBACK_APP_PATH" ]; then
    APP_PATH="$FALLBACK_APP_PATH"
elif [ ! -d "$APP_PATH" ] && [ -d "$SCRIPT_DIR/MiniDock.app" ]; then
    APP_PATH="$SCRIPT_DIR/MiniDock.app"
elif [ ! -d "$APP_PATH" ] && [ -d "$HOME/Projects/MiniDock/MiniDock.app" ]; then
    APP_PATH="$HOME/Projects/MiniDock/MiniDock.app"
fi

show_help() {
    echo "FlowDock - Screen-Edge Native macOS Productivity Dock & Command Center"
    echo ""
    echo "Usage: flowdock [command]  (or minidock [command])"
    echo ""
    echo "Commands:"
    echo "  command             Toggle the Raycast-style FlowDock Command Palette (⌥ Space)"
    echo "  edit                Toggle App Launcher Edit Mode (wiggle & remove badges)"
    echo "  settings            Open FlowDock Preferences"
    echo "  enable              Start FlowDock and enable Apple Dock autohide"
    echo "  disable             Stop FlowDock and restore standard Apple Dock"
    echo "  restore-apple-dock  Safely restore Apple Dock to always visible"
    echo "  status              Display current FlowDock & Apple Dock status"
    echo "  restart             Restart FlowDock"
    echo "  autostart enable    Configure FlowDock to launch automatically at login"
    echo "  autostart disable   Disable launch at login"
    echo ""
}

get_apple_dock_status() {
    local val
    val=$(defaults read com.apple.dock autohide 2>/dev/null || echo "0")
    if [ "$val" = "1" ] || [ "$val" = "true" ]; then
        echo "Auto-Hidden"
    else
        echo "Visible"
    fi
}

get_flowdock_status() {
    if pgrep -x "MiniDock" >/dev/null 2>&1; then
        echo "Running (PID: $(pgrep -x MiniDock | head -n 1))"
    else
        echo "Stopped"
    fi
}

case "$1" in
    command|palette)
        echo "==> Opening FlowDock Command Palette..."
        if pgrep -x "MiniDock" >/dev/null 2>&1; then
            killall -USR2 MiniDock 2>/dev/null || true
        else
            open "$APP_PATH"
            sleep 0.5
            killall -USR2 MiniDock 2>/dev/null || true
        fi
        ;;

    edit|edit-mode|edit-apps)
        echo "==> Toggling FlowDock App Edit Mode..."
        open "minidock://edit"
        ;;

    enable)
        echo "==> Enabling FlowDock..."
        echo "==> Setting Apple Dock to auto-hide..."
        defaults write com.apple.dock autohide -bool true
        killall Dock 2>/dev/null || true
        
        echo "==> Launching FlowDock ($APP_PATH)..."
        if ! pgrep -x "MiniDock" >/dev/null 2>&1; then
            open "$APP_PATH"
        fi
        echo "FlowDock is now active."
        ;;
        
    disable)
        echo "==> Disabling FlowDock..."
        killall MiniDock 2>/dev/null || true
        
        echo "==> Restoring Apple Dock..."
        defaults write com.apple.dock autohide -bool false
        killall Dock 2>/dev/null || true
        echo "FlowDock disabled. Standard Apple Dock restored."
        ;;
        
    restore-apple-dock)
        echo "==> Safely restoring Apple Dock..."
        defaults write com.apple.dock autohide -bool false
        killall Dock 2>/dev/null || true
        echo "Standard Apple Dock has been restored."
        ;;
        
    status)
        echo "FlowDock Status:   $(get_flowdock_status)"
        echo "Apple Dock Status: $(get_apple_dock_status)"
        if [ -f "$PLIST_PATH" ]; then
            echo "Auto-Start:        Enabled ($PLIST_PATH)"
        else
            echo "Auto-Start:        Disabled"
        fi
        ;;
        
    settings)
        echo "==> Opening FlowDock Settings..."
        if [ -n "$2" ]; then
            open "minidock://settings/$2"
        elif pgrep -x "MiniDock" >/dev/null 2>&1; then
            killall -USR1 MiniDock 2>/dev/null || true
        else
            open "$APP_PATH"
        fi
        ;;
        
    autostart)
        case "$2" in
            enable)
                mkdir -p "$HOME/Library/LaunchAgents"
                cat << PLIST_EOF > "$PLIST_PATH"
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.minidock</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/open</string>
        <string>-a</string>
        <string>$APP_PATH</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <false/>
    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
PLIST_EOF
                launchctl unload "$PLIST_PATH" 2>/dev/null || true
                launchctl load "$PLIST_PATH"
                echo "Auto-start enabled at login via LaunchAgent."
                ;;
            disable)
                if [ -f "$PLIST_PATH" ]; then
                    launchctl unload "$PLIST_PATH" 2>/dev/null || true
                    rm -f "$PLIST_PATH"
                    echo "Auto-start disabled."
                else
                    echo "Auto-start was not configured."
                fi
                ;;
            *)
                echo "Usage: flowdock autostart [enable|disable]"
                exit 1
                ;;
        esac
        ;;
        
    restart)
        echo "==> Restarting FlowDock..."
        killall MiniDock 2>/dev/null || true
        sleep 0.5
        open "$APP_PATH"
        echo "FlowDock restarted."
        ;;
        
    *)
        show_help
        ;;
esac
